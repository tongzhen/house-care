{
  "expo": {
    "name": "House Care",
    "slug": "house-care",
    "version": "0.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "icon": "./assets/icon.png",
    "scheme": "housecare",
    "plugins": [
      "expo-router",
      "expo-sqlite",
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow House Care to select an issue photo.",
          "microphonePermission": false
        }
      ],
      "expo-notifications",
      "expo-localization",
      "expo-sharing",
      [
        "expo-calendar",
        {
          "calendarPermission": "Allow House Care to access your calendars so you can choose where to save a maintenance action."
        }
      ],
      "@react-native-community/datetimepicker"
    ],
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.housecare.app",
      "buildNumber": "1",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.housecare.app",
      "versionCode": 1,
      "permissions": [
        "android.permission.POST_NOTIFICATIONS",
        "android.permission.READ_CALENDAR",
        "android.permission.WRITE_CALENDAR"
      ],
      "blockedPermissions": [
        "android.permission.RECORD_AUDIO"
      ]
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "bacb1410-65d3-467f-917c-a673b25c4138"
      }
    },
    "owner": "zhen.tong"
  }
}
