{
  "expo": {
    "name": "House Care",
    "slug": "house-care",
    "version": "0.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "icon": "./assets/housecare-icons/icon.png",
    "scheme": "housecare",
    "plugins": [
      "expo-router",
      "expo-sqlite",
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow House Care to select an issue photo.",
          "microphonePermission": false
        }
      ],
      "expo-notifications",
      "expo-localization",
      "expo-sharing",
      "@react-native-community/datetimepicker"
    ],
    "ios": {
      "icon": "./assets/housecare-icons/icon.png",
      "supportsTablet": false,
      "bundleIdentifier": "com.housecare.app",
      "buildNumber": "1",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "icon": "./assets/housecare-icons/icon.png",
      "adaptiveIcon": {
        "foregroundImage": "./assets/housecare-icons/adaptive-foreground.png",
        "backgroundColor": "#FAF8F2",
        "monochromeImage": "./assets/housecare-icons/adaptive-monochrome.png"
      },
      "package": "com.housecare.app",
      "versionCode": 1,
      "permissions": [
        "android.permission.POST_NOTIFICATIONS"
      ],
      "blockedPermissions": [
        "android.permission.RECORD_AUDIO"
      ]
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "bacb1410-65d3-467f-917c-a673b25c4138"
      }
    },
    "owner": "zhen.tong"
  }
}
