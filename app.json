{
  "expo": {
    "name": "House Care",
    "slug": "house-care",
    "version": "0.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "scheme": "housecare",
    "plugins": [
      "expo-router",
      "expo-sqlite",
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow House Care to select an issue photo."
        }
      ],
      "expo-notifications",
      "expo-localization",
      "expo-sharing",
      [
        "expo-calendar",
        {
          "calendarPermission": "Allow House Care to access your calendars so you can choose where to save a maintenance action."
        }
      ],
      "@react-native-community/datetimepicker"
    ],
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.housecare.app"
    },
    "android": {
      "package": "com.housecare.app"
    }
  }
}
