{
  "expo": {
    "name": "House Care",
    "slug": "house-care",
    "version": "0.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "icon": "./assets/icon.png",
    "scheme": "housecare",
    "plugins": [
      "expo-router",
      "expo-sqlite",
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow House Care to select an issue photo."
        }
      ],
      "expo-notifications",
      "expo-localization",
      "expo-sharing",
      [
        "expo-calendar",
        {
          "calendarPermission": "Allow House Care to access your calendars so you can choose where to save a maintenance action."
        }
      ],
      "@react-native-community/datetimepicker"
    ],
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.housecare.app"
    },
    "android": {
      "package": "com.housecare.app",
      "permissions": ["POST_NOTIFICATIONS"]
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "bacb1410-65d3-467f-917c-a673b25c4138"
      }
    },
    "owner": "zhen.tong"
  }
}
