{
  "name": "house-care",
  "version": "0.1.0",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "typecheck": "tsc --noEmit",
    "test": "jest --runInBand",
    "e2e:maestro": "./scripts/run-maestro.sh test maestro/flows",
    "e2e:android": "./scripts/run-maestro.sh --platform android test maestro/flows",
    "e2e:ios": "./scripts/run-maestro.sh --platform ios test maestro/flows",
    "validate:catalog": "jest src/__tests__/catalogValidation.test.ts --runInBand",
    "generate:notices": "node scripts/generate-third-party-notices.mjs",
    "notices:check": "node scripts/generate-third-party-notices.mjs --check",
    "lint": "expo lint"
  },
  "dependencies": {
    "@react-native-community/datetimepicker": "9.1.0",
    "expo": "~57.0.14",
    "expo-application": "~57.0.2",
    "expo-document-picker": "~57.0.1",
    "expo-file-system": "~57.0.4",
    "expo-image-manipulator": "~57.0.11",
    "expo-image-picker": "~57.0.11",
    "expo-intent-launcher": "~57.0.1",
    "expo-localization": "~57.0.1",
    "expo-notifications": "~57.0.12",
    "expo-print": "~57.0.1",
    "expo-router": "~58.0.32",
    "expo-sharing": "~57.0.13",
    "expo-sqlite": "~57.0.1",
    "expo-status-bar": "~57.0.1",
    "i18next": "^26.3.6",
    "jszip": "^3.10.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-i18next": "^17.0.11",
    "react-native": "0.86.2",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-svg": "15.15.4",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@testing-library/react-native": "^14.0.1",
    "@types/jest": "^30.0.0",
    "@types/react": "~19.2.2",
    "eslint": "^9.39.5",
    "eslint-config-expo": "~57.0.1",
    "jest": "^29.7.0",
    "jest-expo": "^57.0.4",
    "typescript": "~6.0.3"
  }
